APP_HOST=school.example.com

DJANGO_SECRET_KEY=replace-with-a-long-random-production-secret
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=school.example.com
SCHOOL_TIME_ZONE=Europe/Riga
DJANGO_TIME_ZONE=UTC

POSTGRES_DB=ice_school
POSTGRES_USER=ice_school
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_SECURE_HSTS_SECONDS=3600
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=0
DJANGO_SECURE_HSTS_PRELOAD=0
TRUSTED_PROXY_IPS=172.30.0.10
AXES_FAILURE_LIMIT=5

MFA_PREAUTH_TTL_SECONDS=300
MFA_PRIVILEGED_SESSION_MAX_AGE_SECONDS=43200
MFA_TOTP_ISSUER='Ice School'

SCHEDULER_LIFECYCLE_INTERVAL_SECONDS=3600
SCHEDULER_GENERATION_INTERVAL_SECONDS=21600
SCHEDULER_GENERATION_HORIZON_DAYS=60
# A stuck job is terminated after its timeout. Generation is capped by lifecycle cadence by default.
SCHEDULER_LIFECYCLE_TIMEOUT_SECONDS=3600
SCHEDULER_GENERATION_TIMEOUT_SECONDS=3600
# Optional dead-man pings. Keep blank when no external monitoring is configured.
SCHEDULER_LIFECYCLE_SUCCESS_PING_URL=
SCHEDULER_GENERATION_SUCCESS_PING_URL=
# Scheduler becomes unhealthy after ~2 job intervals plus this grace.
SCHEDULER_HEALTH_GRACE_SECONDS=300

BACKUP_HOST_PATH=./backups
BACKUP_INTERVAL_SECONDS=86400
# Stop a stuck pg_dump so the backup loop can retry on the next interval.
BACKUP_TIMEOUT_SECONDS=3600
BACKUP_RETENTION_DAYS=14
BACKUP_SUCCESS_PING_URL=
MONITORING_HTTP_TIMEOUT_SECONDS=10

GUNICORN_WORKERS=3
GUNICORN_TIMEOUT_SECONDS=30

# Prevent unbounded Docker json-file logs from filling the production disk.
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILES=5

YANDEX_OAUTH_CLIENT_ID=
YANDEX_OAUTH_CLIENT_SECRET=
YANDEX_OAUTH_SCOPE=login:info
VKID_CLIENT_ID=
VKID_SCOPE=
EXTERNAL_AUTH_FLOW_TTL_SECONDS=600
EXTERNAL_AUTH_HTTP_TIMEOUT_SECONDS=10
ACCOUNT_INVITATION_TTL_HOURS=168
