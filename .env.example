DJANGO_SECRET_KEY=dev-only-change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Use an IANA time zone for the school location, e.g. Europe/Riga or Asia/Tokyo.
SCHOOL_TIME_ZONE=UTC
DJANGO_TIME_ZONE=UTC

POSTGRES_DB=ice_school
POSTGRES_USER=ice_school
POSTGRES_PASSWORD=ice_school
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

SCHEDULING_RSVP_DEADLINE_MINUTES_BEFORE_START=180
SCHEDULING_DECISION_DEADLINE_MINUTES_BEFORE_START=120

# Production: set DJANGO_DEBUG=0 and use a strong unique secret key.
DJANGO_SECURE_SSL_REDIRECT=0
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=0
DJANGO_SECURE_HSTS_PRELOAD=0

AXES_FAILURE_LIMIT=5

# Privileged local accounts (staff/superuser/manager permissions) require TOTP MFA.
# Password-only pre-authentication is intentionally short-lived.
MFA_PREAUTH_TTL_SECONDS=300
# Verified privileged sessions expire independently of the ordinary Django session.
MFA_PRIVILEGED_SESSION_AGE_SECONDS=43200
# Label shown by authenticator applications.
MFA_TOTP_ISSUER='Ice School'

# Empty by default: direct clients' X-Real-IP headers are ignored.
# Production: list the direct reverse-proxy address(es), comma-separated.
TRUSTED_PROXY_IPS=


# External login. Register exact callback URLs:
#   https://<school-host>/accounts/external/yandex/callback/
#   https://<school-host>/accounts/external/vk/callback/
YANDEX_OAUTH_CLIENT_ID=
YANDEX_OAUTH_CLIENT_SECRET=
YANDEX_OAUTH_SCOPE=login:info

VKID_CLIENT_ID=
# No email/phone scope is requested by default; provider subject is sufficient.
VKID_SCOPE=

EXTERNAL_AUTH_FLOW_TTL_SECONDS=600
EXTERNAL_AUTH_HTTP_TIMEOUT_SECONDS=10
ACCOUNT_INVITATION_TTL_HOURS=168
